<a href="#" class="card card-sm news-card link-trapeze-horizontal{% if extra_class %} {{ extra_class }}{% endif %}">
  {% block image -%}
  <figure class="card-img-top mb-1">
    <img src="./images/styleguide/{{ image_uri|default('news-card.jpg') }}" class="img-fluid" title="L'illusion de neutralité occulte les biais de l'IA générative" alt="Illustration de différentes peuples et cultures" />
    {% block news_media %}
    <figcaption class="bg-white">
      {% include '@atoms/news-format/news-format.twig' with { media_type: "Video", media_icon: "#play-circle", media_value: "1:30"} %}
    </figcaption>
    {% endblock %}
  </figure>
  {% endblock -%}
  {% block card_body %}
  <div class="card-body">
    {% block content %}
    <h3 class="{{ title_class|default('h5 mb-1') }} card-title">{{ title|default("L'illusion de neutralité occulte les biais de l'IA générative") }}</h3>
    <p class="{{ body_class|default('mb-1') }}">{{ body|default("Une équipe de l’EPFL a montré théoriquement que, dans des matériaux très ordonnés...") }}</p>
    <time datetime="2018-03-26" class="small mb-0"><span class="sr-only">Publié: </span>{{ pubdate|default('Il y a 2 jours') }}</time>
    {% endblock %}
  </div>
  {% endblock -%}
</a>
