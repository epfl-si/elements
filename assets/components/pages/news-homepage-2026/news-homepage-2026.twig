{% set isSpecial = true %}
{% set isNews = true %}

{% extends "@templates/base/base-news.twig" %}

{% block grid %}{% endblock %}

{% block content %}
<div class="container">
  {% include '@content-types/news-2026/news-2026-featured.twig' %}
  {% include '@content-types/news-2026/news-2026.twig' with {
    title: "Intelligence artificielle",
    more_link: true
  } %}
</div>
<div class="mt-5">
  {% include '@organisms/fullwidth-teaser/fullwidth-teaser-simplified.twig' %}
</div>
<div class="container py-5">
  <div class="row">
    <div class="col-md-8 offset-md-2">
      <div class="d-flex align-items-baseline">
        <h3 class="mb-2">Santé</h3>
        <a class="ml-3 text-arrow gap-2 red-arrow" href="#">Tout voir</a>
      </div>
      {% include '@molecules/list-group/list-group-news.twig' with { title: false, bottomlink: false, tag: true } %}
    </div>
  </div>
</div>
<div class="bg-gray-100">
  <div class="container py-5">
    <div class="row">
      <div class="col-md-12">
        {% include '@atoms/list/list-ranked.twig' %}
      </div>
    </div>
  </div>
</div>
<div class="container py-5">
  <div class="row">
    <div class="col-md-12">
      {% include '@molecules/carousel/carousel-news.twig' %}
    </div>
  </div>
</div>
<div class="bg-gray-100">
  <div class="container py-5">
    <div class="row">
      <div class="col-md-12">
        {% include '@organisms/newsletter-sign-up/newsletter-sign-up-link.twig' with { add_wrapper: false } %}
      </div>
    </div>
  </div>
</div>
<div class="container py-5">
  {% include '@content-types/news-2026/news-2026-listing-brief.twig' %}
</div>
<div class="container pb-5">
  <div class="row">
    <div class="col-md-12">
      <div class="d-flex align-items-baseline">
        <h3 class="mb-2">Innovation</h3>
        <a class="ml-3 text-arrow gap-2 red-arrow" href="#">Tout voir</a>
      </div>
      <div class="overflow-hidden">
        {% include '@content-types/news-2026/news-2026-horizontal-listing-gray-news-cards.twig' %}
      </div>
    </div>
  </div>
</div>
{% endblock %}
