{% set isSpecial = true %}
{% set isNews = true %}

{% extends "@templates/base/base-news.twig" %}

{% block grid %}{% endblock %}

{% block content %}

<div class="container">
  <div class="row">
    <div class="col-md-12">
      <h1 class="h2">Search news</h1>
    </div>
  </div>
</div>

<div class="container">
  {% include '@organisms/search-and-filter/search-and-filter-news.twig' %}
</div>

<div class="container py-5">
  <div class="row">
    <div class="col-md-12">
      {% include '@molecules/list-group/list-group-news.twig' with { title: false, bottomlink: false, tag: true } %}
    </div>
  </div>
</div>

<div class="container mb-5">
  <div class="row">
    <div class="col-md-12">
      {% include '@molecules/pagination/pagination.twig' %}
    </div>
  </div>
</div>

{% endblock %}
