{% set items = items|default(["Legolas", "Jar Jar Binks", "None of them", "The fourth choice", "42"]) %}

<div class="form-group">
  <label {% if sronly %}class="sr-only"{% endif %}>{% if label %}{{~ label}}{% else %}Choose wisely{% endif %}</label>
  <select id="select-input" class="custom-select">
    <option selected>{% if selection %} {{~ selection}} {% else %}Choose wisely{% endif %}</option>
    {% for item in items %}
      <option value={{ loop.index }}>{{ item.label|default(item) }}</option>
    {% endfor %}
  </select>
</div>
