{% set pretty_name = pretty_name ?: 'Scopus' %}
{% set icon = icon ?: 'icon-scopus' %}
{% set round = round ? ' research-icon-round' : '' %}
{% set discrete = discrete ? ' research-icon-discrete' : '' %}
{% set negative = negative ? ' research-icon-negative' : '' %}
{% set url = url ?:  '#' %}
<a href="{{ url }}" class="{{ 'research-icon research-' ~ icon ~ round ~ negative ~ discrete }}" target="_blank" rel="nofollow noopener">
  {% include '@atoms/icon/icon.twig' with { icon: icon } %}
  <span class="sr-only">{{ pretty_name }}</span>
</a>
