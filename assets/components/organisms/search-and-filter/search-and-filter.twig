<div class="search-filters mt-4">
  <form action="" method="get">
    {% include '@molecules/form-group/form-group-search.twig' %}
    {% include '@atoms/select/select.twig' with { label: 'Pic a character', selection: 'Good choice' } %}
    {% include '@atoms/select/select-multiple.twig' with { 
      label: 'Pick a restaurant',
      filter: FALSE,
      items_multiple: [
        { label: 'Chuck Testa\'s tavern', value: 1 },
        { label: 'The Sage Cattabriga-Alosa hideout', value: 2 },
        { label: 'Nikola Tesla Drive-in', value: 3 },
        { label: 'A Love for Pizza 🍕', value: 4 },
        { type: 'divider' },
        { label: 'The Hydron Collider', value: 5 },
        { label: 'There\'s no place like 127.0.0.1', value: 6 },
        { type: 'optgroup', label: 'EPFL', options: [
          { label: 'Holy Cow', value: 10 },
          { label: 'Satellite', value: 11 }
        ]}
      ]
    } %}
    {% include '@atoms/select/select-multiple.twig' %}
    {% include '@atoms/select/select-date.twig' with { label: 'Select a date' } %}
  </form>

  <div class="event-filter-tags mt-2">
    {% include "@molecules/filters/filters-search.twig" with {
      label: 'Search filters',
      items: [
        { label: 'Legolas' },
